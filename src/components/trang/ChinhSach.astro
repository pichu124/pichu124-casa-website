---
// Chính sách bảo vệ dữ liệu cá nhân (Luật Bảo vệ dữ liệu cá nhân 91/2025/QH15, hiệu lực 01/01/2026, và văn bản hướng dẫn).
// Nội dung: phiếu bổ sung thông tin câu 18–21 (18/11/2026).
// BẢN NHÁP: cần chủ trường và người có chuyên môn pháp lý rà soát trước khi đăng.
import Base from '../../layouts/Base.astro';
import Can from '../Can.astro';
import type { Lang } from '../../data/co-so';
import { LIEN_HE } from '../../data/lien-he';
import { url, taoT } from '../../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = taoT(lang);
const duongDan = [
  { ten: t('Trang chủ', 'Home'), href: url('home', lang) },
  { ten: t('Chính sách bảo vệ dữ liệu cá nhân', 'Personal Data Protection Policy'), href: url('privacy', lang) },
];
---
<Base lang={lang} routeKey="privacy" duongDan={duongDan}
  tieuDe={t('Chính sách bảo vệ dữ liệu cá nhân', 'Personal Data Protection Policy')}
  moTa={t('Casa Preschool thu thông tin gì qua form đăng ký tham quan, dùng vào việc gì, lưu bao lâu và quyền của phụ huynh.', 'What Casa Preschool collects through the visit form, how it is used, how long it is kept and your rights.')}>
  <section class="phan phan--sat">
    <div class="khung noi-dung">
      <h1>{t('Chính sách bảo vệ dữ liệu cá nhân', 'Personal Data Protection Policy')}</h1>

      <h2>{t('1. Bên kiểm soát dữ liệu', '1. Data controller')}</h2>
      <p>{LIEN_HE.donVi ? LIEN_HE.donVi[lang] : <Can noi={t('tên đơn vị', 'entity name')} />}</p>
      <ul>
        <li>{t('Địa chỉ', 'Address')}: {LIEN_HE.diaChiDonVi[lang]}</li>
        <li>Email: <a href={`mailto:${LIEN_HE.email}`}>{LIEN_HE.email}</a></li>
        <li>{t('Điện thoại', 'Phone')}: <a href={LIEN_HE.tel}>{lang === 'en' ? LIEN_HE.hotlineQuocTe : LIEN_HE.hotline}</a></li>
      </ul>

      <h2>{t('2. Thông tin chúng tôi thu', '2. Information we collect')}</h2>
      <p>{t('Qua form đăng ký tham quan, chúng tôi chỉ thu:', 'Through the visit form we collect only:')}</p>
      <ul>
        <li>{t('Họ tên ba/mẹ;', "Parent's name;")}</li>
        <li>{t('Số điện thoại;', 'Phone number;')}</li>
        <li>{t('Tháng và năm sinh của bé (không thu tên bé hay thông tin sức khỏe);', "Child's month and year of birth (we do not collect the child's name or health information);")}</li>
        <li>{t('Cơ sở gia đình muốn tham quan.', 'The campus your family would like to visit.')}</li>
      </ul>
      <p>{t('Ngoài ra, nếu anh/chị chọn, chúng tôi ghi nhận anh/chị biết trường qua đâu (không bắt buộc), và nguồn dẫn anh/chị tới trang có form, ví dụ Google Maps, Facebook hay tên miền của trang trước đó. Hai thông tin này không nhận diện được anh/chị; nhà trường chỉ dùng để biết kênh nào giúp phụ huynh tìm đến trường.', 'In addition, if you choose, we record how you heard about the school (optional), and the source that brought you to the page with the form, for example Google Maps, Facebook or the domain of the previous page. These two items do not identify you; the school uses them only to learn which channels help parents find us.')}</p>

      <h2>{t('3. Mục đích', '3. Purpose')}</h2>
      <p>{t('Chỉ để liên hệ tư vấn, hẹn lịch tham quan và gửi biểu phí theo yêu cầu của gia đình. Chúng tôi không dùng thông tin này để quảng cáo cho bên khác và không bán cho bất kỳ ai.', 'Only to contact you, arrange a visit and send the fee schedule you asked for. We do not use this information for third-party advertising and never sell it.')}</p>

      <h2>{t('4. Cơ sở xử lý', '4. Legal basis')}</h2>
      <p>{t('Sự đồng ý của anh/chị, thể hiện bằng việc tích vào ô đồng ý trước khi gửi form. Anh/chị có thể rút lại đồng ý bất cứ lúc nào.', 'Your consent, given by ticking the consent box before sending the form. You may withdraw consent at any time.')}</p>

      <h2>{t('5. Ai được xem thông tin', '5. Who can see the information')}</h2>
      <ul>
        <li>{t('Bộ phận tuyển sinh: nhận thông tin qua hộp thư tuyển sinh, liên hệ tư vấn, nhập vào hệ thống quản lý tuyển sinh nội bộ của nhà trường và chuyển cho cơ sở gia đình quan tâm.', 'Admissions team: receives your request in the admissions mailbox, contacts you, records it in the school’s internal admissions system and passes it to the campus you are interested in.')}</li>
        <li>{t('Cơ sở gia đình quan tâm: chăm sóc, tư vấn và tổ chức buổi tham quan.', 'The campus you are interested in: follows up, advises you and hosts your visit.')}</li>
        <li>{t('Ban lãnh đạo nhà trường: nhận báo cáo tổng hợp về tuyển sinh.', 'School leadership: receives summary admissions reports.')}</li>
        <li>{t('Người vận hành kỹ thuật website: chỉ khi cần để vận hành, bảo trì và xử lý sự cố.', 'The website’s technical operator: only when needed to run, maintain and fix the website.')}</li>
      </ul>
      <p>{t('Thông tin được gửi về hộp thư tuyển sinh của trường (dịch vụ Google Workspace), lưu trên máy chủ của website và trong hệ thống quản lý tuyển sinh nội bộ của nhà trường.', "Information is sent to the school's admissions mailbox (Google Workspace) and stored on the website's server and in the school's internal admissions system.")}</p>

      <h2>{t('6. Thời gian lưu', '6. How long we keep it')}</h2>
      <p>{t('Thông tin đăng ký được lưu tối đa 12 tháng kể từ ngày anh/chị gửi, chỉ cho mục đích tư vấn, hẹn lịch tham quan và theo dõi nhu cầu tuyển sinh. Hết thời hạn, hoặc khi không còn cần cho mục đích này, dữ liệu được rà soát và xoá, trừ trường hợp pháp luật yêu cầu lưu giữ. Anh/chị có thể yêu cầu xoá sớm hơn bất cứ lúc nào.', 'Your request is kept for at most 12 months from the day you send it, only to advise you, arrange a visit and follow up on admissions. After that, or when it is no longer needed for this purpose, the data is reviewed and deleted unless the law requires us to keep it. You can ask us to delete it sooner at any time.')}</p>

      <h2>{t('7. Quyền của anh/chị', '7. Your rights')}</h2>
      <p>{t('Theo Luật Bảo vệ dữ liệu cá nhân số 91/2025/QH15 và các văn bản hướng dẫn, anh/chị có quyền được biết, đồng ý hoặc rút lại đồng ý, xem và sửa thông tin, yêu cầu xoá hoặc hạn chế xử lý, phản đối việc xử lý và khiếu nại.', 'Under the Personal Data Protection Law No. 91/2025/QH15 and its implementing regulations, you have the right to be informed, to give or withdraw consent, to access and correct your information, to request deletion or restriction of processing, to object to processing, and to complain.')}</p>
      <p>{t('Gửi yêu cầu tới', 'Send requests to')} <a href={`mailto:${LIEN_HE.email}`}>{LIEN_HE.email}</a>. {t('Nhà trường tiếp nhận và xử lý theo quy định pháp luật hiện hành.', 'The school will handle your request in line with current law.')}</p>

      <h2>{t('8. Cookie và theo dõi', '8. Cookies and tracking')}</h2>
      <p>{t('Website không dùng cookie quảng cáo hay công cụ theo dõi người xem. Nguồn truy cập ở mục 2 chỉ được đọc từ đường dẫn và trang trước đó khi anh/chị mở trang có form, không lưu trên máy của anh/chị.', 'This website does not use advertising cookies or visitor-tracking tools. The access source in section 2 is read only from the link and the previous page when you open a page with the form, and nothing is stored on your device.')}</p>

      <h2>{t('9. Thay đổi chính sách', '9. Changes to this policy')}</h2>
      <p>{t('Khi chính sách thay đổi, bản mới được đăng tại trang này kèm ngày cập nhật.', 'When this policy changes, the new version will be posted on this page with the date of the update.')} <Can noi={t('ngày hiệu lực: điền ngày website chính thức chạy trên tên miền chính', 'effective date: the day the website goes live on the main domain')} /></p>
    </div>
  </section>
</Base>
