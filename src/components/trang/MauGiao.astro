---
// Mẫu giáo 3–6 tuổi (QUYET-DINH Q13). Trang nói về việc con học ở Casa;
// phần giải thích bản thân khung chương trình nằm ở bài viết (tránh trùng, KIEN-TRUC mục 3).
import Base from '../../layouts/Base.astro';
import KhoiCta from '../KhoiCta.astro';
import BangLop from '../BangLop.astro';
import BoAnh from '../BoAnh.astro';
import { ANH } from '../../data/anh';
import type { Lang } from '../../data/co-so';
import { url, taoT } from '../../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = taoT(lang);
const duongDan = [
  { ten: t('Trang chủ', 'Home'), href: url('home', lang) },
  { ten: t('Chương trình', 'Programmes'), href: url('programmes', lang) },
  { ten: t('Mẫu giáo 3–6 tuổi', 'Kindergarten, 3–6 years'), href: url('kindergarten', lang) },
];
// Ba năm mẫu giáo: chỉ dùng nội dung bài "Cambridge Early Years là gì" (đã duyệt, nguồn Cambridge International).
// Mục tiêu chi tiết theo từng tuổi ở Casa chờ chuyên môn duyệt (bản Kế hoạch, Q8) rồi mới bổ sung.
const NAM = [
  { ten: 'Early Years 1', tuoi: t('3–4 tuổi', '3–4 years'),
    noi: t('Năm đầu mẫu giáo. Bé học qua chơi trong sáu lĩnh vực phát triển, bắt đầu từ những việc nhỏ và gần gũi. Ví dụ với toán: đếm đồ vật trong phạm vi nhỏ.', 'The first kindergarten year. Children learn through play across six areas of development, starting with small, familiar things. For example in maths: counting a small number of objects.') },
  { ten: 'Early Years 2', tuoi: t('4–5 tuổi', '4–5 years'),
    noi: t('Bé tiếp tục cả sáu lĩnh vực ở mức cao hơn. Kỹ năng đã học năm trước được quay lại, mở rộng và vận dụng trong nhiều hoạt động hơn.', 'Children continue all six areas at a higher level. Skills from the year before are revisited, extended and used in more activities.') },
  { ten: 'Early Years 3', tuoi: t('5–6 tuổi', '5–6 years'),
    noi: t('Lớp tiền tiểu học. Bé dùng những gì đã học vào tình huống thật, ví dụ dùng việc đếm để so sánh, thêm bớt và giải bài toán nhỏ, đồng thời được bổ sung kỹ năng chuẩn bị vào lớp 1.', 'The pre-primary class. Children use what they have learned in real situations, for example using counting to compare, add and take away and solve small problems, while building extra skills to prepare for Grade 1.'),
    lienKet: t('Xem lớp tiền tiểu học ↓', 'See the pre-primary class ↓') },
];
const LINH_VUC = [
  t('Giao tiếp, ngôn ngữ và đọc viết', 'Communication, language and literacy'),
  t('Biểu đạt sáng tạo', 'Creative expression'),
  t('Toán', 'Mathematics'),
  t('Phát triển cá nhân, xã hội và cảm xúc', 'Personal, social and emotional development'),
  t('Phát triển thể chất', 'Physical development'),
  t('Khám phá thế giới', 'Understanding the world'),
];
---
<Base lang={lang} routeKey="kindergarten" duongDan={duongDan}
  tieuDe={t('Mẫu giáo 3–6 tuổi theo khung Cambridge Early Years', 'Kindergarten for ages 3–6, Cambridge Early Years framework')}
  moTa={t(
    'Ba năm mẫu giáo theo khung Cambridge Early Years: Early Years 1, 2, 3; lớp tiền tiểu học bổ sung kỹ năng chuẩn bị vào lớp 1; hai hệ quốc tế và song ngữ.',
    'Three kindergarten years based on the Cambridge Early Years framework: Early Years 1, 2 and 3, a pre-primary class preparing for Grade 1, and two tracks.',
  )}>

  <section class="dau-trang-con">
    <div class="khung">
      <p class="nhan-phan">{t('Mẫu giáo 3–6 tuổi', 'Kindergarten, 3–6 years')}</p>
      <h1>{t('Chương trình theo khung Cambridge Early Years cho trẻ 3–6 tuổi', 'A programme based on the Cambridge Early Years framework for children aged 3–6')}</h1>
      <p class="dau-trang__phu">{t('Mỗi năm con học đúng mức của tuổi mình; kỹ năng được nhắc lại và nâng dần qua từng năm.', 'Each year matches your child’s age, and skills are revisited and built on year after year.')}</p>
    </div>
  </section>

  <section class="phan phan--phu phan--sat" aria-labelledby="linh-vuc">
    <div class="khung noi-dung">
      <h2 id="linh-vuc">{t('Con học qua chơi, phát triển đều sáu lĩnh vực', 'Learning through play across six areas')}</h2>
      <p>{t('Con phát triển cả ngôn ngữ, toán, vận động, cảm xúc và sự tò mò, không chỉ học chữ và số:', 'Children grow in language, maths, movement, emotions and curiosity, not just letters and numbers:')}</p>
      <ol>{LINH_VUC.map((l) => <li>{l}</li>)}</ol>
      <p><a href={url('article-cey', lang)}>{t('Đọc: Cambridge Early Years là gì? Giải thích cho phụ huynh', 'Read: What is Cambridge Early Years? A guide for parents')}</a></p>
    </div>
  </section>

  <section class="phan phan--sat" aria-labelledby="ba-lop">
    <div class="khung">
      <div class="phan__dau">
        <h2 id="ba-lop">{t('Ba năm mẫu giáo, mỗi năm một bước', 'Three kindergarten years, one step at a time')}</h2>
        <p>{t('Mỗi lớp ứng với một năm tuổi. Những gì con học năm trước được quay lại năm sau ở mức cao hơn.', 'Each class matches one year of age. What children learn one year is revisited the next, at a higher level.')}</p>
      </div>
      <ol class="luoi luoi--3 danh-sach-tron" role="list">
        {NAM.map((n) => (
          <li class="the the--nhan">
            <span class="huy-hieu">{n.tuoi}</span>
            <h3>{n.ten}</h3>
            <p class="the__mo-ta">{n.noi}</p>
            {n.lienKet && <p class="the__phu"><a href="#tien-tieu-hoc">{n.lienKet}</a></p>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="phan phan--phu phan--sat" id="tien-tieu-hoc" aria-labelledby="tieu-de-tien-tieu-hoc">
    <div class="khung khung-chu">
      <h2 id="tieu-de-tien-tieu-hoc">{t('Lớp tiền tiểu học (5–6 tuổi)', 'Pre-primary class (ages 5–6)')}</h2>
      <p>{t('Năm cuối mẫu giáo là lớp Early Years 3. Bên cạnh chương trình theo khung Cambridge Early Years, bé được bổ sung kỹ năng chuẩn bị vào lớp 1.', 'The final kindergarten year is Early Years 3. Alongside the programme based on the Cambridge Early Years framework, children build extra skills to prepare for Grade 1.')}</p>
      <p>{t('Lớp tiền tiểu học có ở cả ba cơ sở đang tuyển sinh: Kim Mã, Chùa Láng, Mỹ Đình.', 'The pre-primary class is offered at all three enrolling campuses: Kim Mã, Chùa Láng and Mỹ Đình.')}</p>
      <BoAnh nhan={t('Ảnh lớp mẫu giáo', 'Kindergarten class photos')}
        anh={[ANH.tienTieuHoc, ANH.lopHocTron, ANH.gioHocBan].map((x) => ({ src: x.src, alt: x.alt[lang] }))} />
    </div>
  </section>

  <section class="phan phan--sat" aria-labelledby="he-hoc">
    <div class="khung">
      <div class="phan__dau">
        <h2 id="he-hoc">{t('Hai hệ học', 'Two tracks')}</h2>
        <p>{t('Hệ quốc tế có giáo viên nước ngoài trong mỗi lớp. Hệ song ngữ có hai trợ giảng, giáo viên nước ngoài dạy theo tiết.', 'The international track has a foreign teacher in every class. The bilingual track has two teaching assistants, with a foreign teacher for scheduled lessons.')}</p>
        <p><a href={url('programmes', lang) + '#so-sanh-he'}>{t('So sánh hai hệ chi tiết', 'Compare the two tracks in detail')}</a></p>
      </div>
      <BangLop lang={lang} cot={['songNgu', 'quocTe', 'tienTieuHoc']} tieuDe={t('Lớp mẫu giáo ở từng cơ sở', 'Kindergarten classes at each campus')} />
    </div>
  </section>

  <KhoiCta lang={lang} />
</Base>
