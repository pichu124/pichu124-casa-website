---
// Trang chủ — hướng A trong docs/NOI-DUNG-TRANG.md (chỉ dùng thông tin cấp hệ thống).
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import Can from '../Can.astro';
import { Picture } from 'astro:assets';
import anhLopHoc from '../../assets/anh/lop-hoc-ke-hoc-cu.jpg';
import anhBanTay from '../../assets/anh/ban-tay-co-va-be.jpg';
import KhoiCta from '../KhoiCta.astro';
import MotNgay from '../MotNgay.astro';
import { CO_SO, type Lang } from '../../data/co-so';
import { LIEN_HE, SITE } from '../../data/lien-he';
import { url, taoT, FORM_ANCHOR } from '../../i18n/routes';
import { TEN_CU, KHAU_HIEU } from '../../data/thuong-hieu';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = taoT(lang);

const dangTuyen = CO_SO.filter((c) => c.trangThai === 'dang-tuyen-sinh');
const sapMo = CO_SO.filter((c) => c.trangThai === 'sap-khai-truong');
// Hệ nào có ở cơ sở nào: sinh từ bảng cơ sở, không gõ tay
const coHe = (k: 'quocTe' | 'songNgu') => dangTuyen.filter((c) => c.lop[k] === 'co').map((c) => c.ten[lang]).join(', ');

const schema = [{
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE}/#truong`,
  name: 'Casa Preschool',
  alternateName: TEN_CU,
  url: SITE + '/',
  telephone: LIEN_HE.telSchema,
  email: LIEN_HE.email,
  sameAs: [LIEN_HE.facebook],
}];
---
<Base lang={lang} routeKey="home" tieuDeDayDu schema={schema}
  tieuDe={t('Mầm non Casa Preschool Hà Nội: nhận bé 15 tháng–6 tuổi', 'Casa Preschool preschools in Hanoi, ages 15 months to 6')}
  moTa={t(
    'Hệ thống mầm non hơn 10 năm tại Hà Nội. Ba cơ sở Kim Mã, Chùa Láng, Mỹ Đình đang tuyển sinh; cơ sở Ciputra dự kiến khai trương quý 4/2027.',
    'A preschool group in Hanoi for over 10 years. Kim Mã, Chùa Láng and Mỹ Đình are enrolling; the Ciputra campus is expected to open in Q4 2027.',
  )}>

  <section class="dau-trang">
    <div class="khung dau-trang__luoi">
      <div>
        <p class="nhan-phan">{KHAU_HIEU[lang]}</p>
        <h1>{t('Mầm non Casa Preschool cho bé từ 15 tháng đến 6 tuổi', 'Casa Preschool preschools for children from 15 months to 6 years')}</h1>
        <p class="dau-trang__phu">{t(
          'Hơn 10 năm chăm sóc và giáo dục trẻ tại Hà Nội. Ba cơ sở Kim Mã, Chùa Láng, Mỹ Đình đang tuyển sinh; cơ sở Ciputra dự kiến khai trương quý 4/2027.',
          'Over 10 years of caring for and teaching young children in Hanoi. Our Kim Mã, Chùa Láng and Mỹ Đình campuses are enrolling now; the Ciputra campus is expected to open in Q4 2027.',
        )}</p>
        <div class="cum">
          <a class="nut nut--chinh nut--lon" href={url('admissions', lang) + FORM_ANCHOR}>{t('Đăng ký tham quan', 'Book a visit')}</a>
          <a class="nut nut--phu nut--lon" href={LIEN_HE.tel}><Icon ten="dien-thoai" />{t(`Gọi ${LIEN_HE.hotline}`, `Call ${LIEN_HE.hotlineQuocTe}`)}</a>
        </div>
      </div>
      <Picture class="dau-trang__anh" src={anhLopHoc} formats={['avif', 'webp']} widths={[480, 720, 1000, 1400]}
        sizes="(min-width: 56rem) 42vw, 100vw" loading="eager" fetchpriority="high"
        alt={t('Góc lớp học với kệ gỗ đựng học cụ, chậu cây xanh và cửa kính nhiều ánh sáng', 'A classroom corner with wooden shelves of learning materials, a potted plant and bright glass windows')} />
    </div>
  </section>

  <section class="phan phan--sat" aria-labelledby="chon-co-so">
    <div class="khung">
      <div class="phan__dau">
        <h2 id="chon-co-so">{t('Chọn cơ sở gần bạn', 'Find a campus near you')}</h2>
        <p>{t('Mỗi cơ sở có trang riêng với địa chỉ, bản đồ và lớp học.', 'Each campus has its own page with the address, map and classes.')}</p>
      </div>
      <h3 class="nhom-tieu-de">{t('Ba cơ sở đang tuyển sinh', 'Three campuses enrolling now')}</h3>
      <ul class="luoi danh-sach-tron" role="list">
        {dangTuyen.map((c) => (
          <li class="the the--lien-ket">
            <span class="huy-hieu">{t('Đang tuyển sinh', 'Enrolling now')}</span>
            <h4 class="the__tieu-de"><a class="the__lien-ket" href={url(`co-so-${c.slug}`, lang)}>{t(`Cơ sở ${c.ten.vi}`, `${c.ten.en} campus`)}</a></h4>
            <p class="the__mo-ta">{c.diaChiNgan ? c.diaChiNgan[lang] : <Can noi={t('địa chỉ', 'address')} />}</p>
            <span class="the__chan" aria-hidden="true">{t('Xem cơ sở', 'See campus')} →</span>
          </li>
        ))}
      </ul>
      <h3 class="nhom-tieu-de">{t('Sắp khai trương', 'Opening soon')}</h3>
      <ul class="luoi danh-sach-tron" role="list">
        {sapMo.map((c) => (
          <li class="the the--lien-ket the--sap">
            <span class="huy-hieu huy-hieu--sap">{t('Dự kiến quý 4/2027', 'Expected Q4 2027')}</span>
            <h4 class="the__tieu-de"><a class="the__lien-ket" href={url(`co-so-${c.slug}`, lang)}>{t(`Cơ sở ${c.ten.vi}`, `${c.ten.en} campus`)}</a></h4>
            <p class="the__mo-ta">{t('Khu đô thị Ciputra, phường Phú Thượng. Đăng ký nhận thông tin sớm.', 'Ciputra urban area, Phú Thượng ward. Register for early updates.')}</p>
            <span class="the__chan" aria-hidden="true">{t('Xem cơ sở', 'See campus')} →</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="phan phan--phu" aria-labelledby="theo-tuoi">
    <div class="khung">
      <div class="phan__dau">
        <h2 id="theo-tuoi">{t('Con bạn bao nhiêu tuổi?', 'How old is your child?')}</h2>
        <p>{t('Chọn theo tuổi của bé để xem con sẽ học gì.', "Choose your child's age to see what they will learn.")}</p>
      </div>
      <div class="luoi luoi--3">
        <article class="the the--nhan the--lien-ket">
          <span class="huy-hieu">{t('15 tháng – 3 tuổi', '15 months – 3 years')}</span>
          <h3><a class="the__lien-ket" href={url('nursery', lang)}>{t('Nhà trẻ', 'Nursery')}</a></h3>
          <p class="the__mo-ta">{t('Bé làm quen với lớp học, bạn bè và tiếng Anh. Xem mô hình lớp ở từng cơ sở.', 'Children get used to the classroom, friends and English. See the class model at each campus.')}</p>
          <span class="the__chan" aria-hidden="true">{t('Xem chương trình nhà trẻ', 'See the nursery programme')} →</span>
        </article>
        <article class="the the--nhan the--lien-ket">
          <span class="huy-hieu">{t('3 – 6 tuổi', '3 – 6 years')}</span>
          <h3><a class="the__lien-ket" href={url('kindergarten', lang)}>{t('Mẫu giáo', 'Kindergarten')}</a></h3>
          <p class="the__mo-ta">{t('Chương trình theo khung Cambridge Early Years cho trẻ 3–6 tuổi, có lớp tiền tiểu học chuẩn bị vào lớp 1.', 'A programme based on the Cambridge Early Years framework for children aged 3–6, including a pre-primary class that prepares them for Grade 1.')}</p>
          <span class="the__chan" aria-hidden="true">{t('Xem chương trình mẫu giáo', 'See the kindergarten programme')} →</span>
        </article>
        <article class="the the--nhan the--lien-ket">
          <span class="huy-hieu">{t('5 – 6 tuổi', '5 – 6 years')}</span>
          <h3><a class="the__lien-ket" href={url('kindergarten', lang) + '#tien-tieu-hoc'}>{t('Lớp tiền tiểu học', 'Pre-primary class')}</a></h3>
          <p class="the__mo-ta">{t('Năm cuối mẫu giáo, bé được chuẩn bị kỹ năng để tự tin vào lớp 1. Có ở cả ba cơ sở đang tuyển sinh.', 'In the final kindergarten year, children build the skills to start Grade 1 with confidence. Offered at all three enrolling campuses.')}</p>
          <span class="the__chan" aria-hidden="true">{t('Xem lớp tiền tiểu học', 'See the pre-primary class')} →</span>
        </article>
      </div>
    </div>
  </section>

  <section class="phan" aria-labelledby="hai-he">
    <div class="khung">
      <div class="phan__dau">
        <h2 id="hai-he">{t('Hai hệ học cho trẻ 3–6 tuổi', 'Two tracks for children aged 3–6')}</h2>
        <p>{t('Gia đình chọn hệ phù hợp với mong muốn về tiếng Anh cho con.', 'Families choose the track that fits their hopes for their child’s English.')}</p>
      </div>
      <div class="luoi luoi--2">
        <div class="the">
          <h3>{t('Hệ quốc tế', 'International track')}</h3>
          <p class="the__mo-ta">{t('Mỗi lớp có giáo viên chủ nhiệm, trợ giảng và giáo viên nước ngoài.', 'Each class has a homeroom teacher, a teaching assistant and a foreign teacher.')}</p>
          <p class="the__phu">{t(`Có ở cơ sở: ${coHe('quocTe')}`, `Available at: ${coHe('quocTe')}`)}</p>
        </div>
        <div class="the">
          <h3>{t('Hệ song ngữ', 'Bilingual track')}</h3>
          <p class="the__mo-ta">{t('Mỗi lớp có giáo viên chủ nhiệm và hai trợ giảng; giáo viên nước ngoài dạy theo tiết.', 'Each class has a homeroom teacher and two teaching assistants; a foreign teacher teaches scheduled lessons.')}</p>
          <p class="the__phu">{t(`Có ở cơ sở: ${coHe('songNgu')}`, `Available at: ${coHe('songNgu')}`)}</p>
        </div>
      </div>
      <p class="sau-luoi"><a href={url('programmes', lang) + '#so-sanh-he'}>{t('So sánh hai hệ chi tiết', 'Compare the two tracks in detail')}</a></p>
    </div>
  </section>

  <section class="phan phan--phu" aria-labelledby="mot-ngay">
    <div class="khung">
      <div class="phan__dau">
        <h2 id="mot-ngay">{t('Một ngày ở Casa', 'A day at Casa')}</h2>
      </div>
      <MotNgay lang={lang} />
    </div>
  </section>

  <section class="phan" aria-labelledby="ve-casa">
    <div class="khung khoi-anh-chu">
      <Picture class="khoi-anh-chu__anh" src={anhBanTay} formats={['avif', 'webp']} widths={[400, 640, 900]}
        sizes="(min-width: 56rem) 40vw, 100vw" loading="lazy"
        alt={t('Bàn tay của cô giáo và các bé đặt chồng lên nhau', "A teacher's hand and the children's hands stacked together")} />
      <div>
        <h2 id="ve-casa">{t('Về Casa Preschool', 'About Casa Preschool')}</h2>
        <p class="nhan-phan">{KHAU_HIEU[lang]}</p>
        <p>{t('Casa Preschool (tên trước đây: Casa dei Bambini) là hệ thống mầm non xuyên suốt hơn 10 năm tại Hà Nội. Ba chiếc lá đỏ trên logo là bố, mẹ và nhà trường cùng nâng đỡ bé lớn lên.', 'Casa Preschool (formerly known as Casa dei Bambini) is a preschool group that has been running in Hanoi for over 10 years. The three red leaves in our logo stand for father, mother and school supporting each child as they grow.')}</p>
        <p><a href={url('about', lang)}>{t('Tìm hiểu về Casa Preschool', 'Learn more about Casa Preschool')}</a></p>
      </div>
    </div>
  </section>

  <KhoiCta lang={lang} />
</Base>
