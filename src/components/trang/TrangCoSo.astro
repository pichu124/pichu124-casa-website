---
// Trang từng cơ sở. Ciputra dùng nội dung soạn sẵn trên Docs (trang Ciputra, FAQ riêng).
import Base from '../../layouts/Base.astro';
import FormDangKy from '../FormDangKy.astro';
import HoiDap from '../HoiDap.astro';
import BangLop from '../BangLop.astro';
import AnhCho from '../AnhCho.astro';
import Can from '../Can.astro';
import Icon from '../Icon.astro';
import { CO_SO, coSoTheoSlug, linkBanDo, type Lang } from '../../data/co-so';
import { LIEN_HE, SITE } from '../../data/lien-he';
import { url, taoT } from '../../i18n/routes';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const t = taoT(lang);
const c = coSoTheoSlug(slug)!;
const ten = c.ten[lang];
const laCiputra = slug === 'ciputra';
const key = `co-so-${slug}`;
const duongDan = [
  { ten: t('Trang chủ', 'Home'), href: url('home', lang) },
  { ten: t('Các cơ sở', 'Campuses'), href: url('campuses', lang) },
  { ten: t(`Cơ sở ${c.ten.vi}`, `${c.ten.en} campus`), href: url(key, lang) },
];

const schema = c.schema ? [{
  '@context': 'https://schema.org',
  '@type': ['Preschool', 'ChildCare'],
  '@id': `${SITE}${url(key, 'vi')}#coso`,
  name: `Casa dei Bambini ${c.ten.vi}`,
  url: SITE + url(key, lang),
  parentOrganization: { '@id': `${SITE}/#truong` },
  telephone: LIEN_HE.telSchema,
  email: LIEN_HE.email,
  address: { '@type': 'PostalAddress', streetAddress: c.schema.streetAddress, addressLocality: c.schema.addressLocality, addressRegion: 'Hà Nội', addressCountry: 'VN' },
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '07:30', closes: '17:30' }],
  sameAs: [LIEN_HE.facebook],
}] : [];

const hoiDapCiputra = [
  { hoi: t('Khi nào cơ sở Ciputra khai trương?', 'When will the Ciputra campus open?'),
    dap: t('Dự kiến quý 4/2027. Gia đình đăng ký sớm sẽ được báo lịch tham quan khi cơ sở hoàn thiện.', 'It is expected to open in Q4 2027. Families who register early will be told the visit schedule once the campus is ready.') },
  { hoi: t('Cơ sở Ciputra ở đâu?', 'Where is the Ciputra campus?'),
    dap: t('Tầng 3, tầng 4 và sân thượng của một tòa nhà 4 tầng trong khu đô thị Ciputra, phường Phú Thượng, Hà Nội. Tên tòa nhà sẽ được cập nhật.', 'On the 3rd and 4th floors and rooftop of a four-storey building in the Ciputra urban area, Phú Thượng ward, Hanoi. The building name will be added later.') },
  { hoi: t('Học phí ở cơ sở Ciputra là bao nhiêu?', 'What are the fees at the Ciputra campus?'),
    dap: t('Biểu phí năm học 2027–2028 đang được hoàn thiện. Gia đình đăng ký nhận thông tin sẽ được gửi biểu phí đầu tiên.', 'The fee schedule for the 2027–2028 school year is being finalised. Families who register will be the first to receive it.') },
];
const schemaHoiDap = laCiputra ? [{
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: hoiDapCiputra.map((q) => ({ '@type': 'Question', name: q.hoi, acceptedAnswer: { '@type': 'Answer', text: q.dap } })),
}] : [];

const tieuDe = laCiputra
  ? t('Casa dei Bambini Ciputra: mầm non theo khung Cambridge Early Years', 'Casa dei Bambini Ciputra: preschool based on Cambridge Early Years')
  : t(`Cơ sở ${c.ten.vi}`, `${c.ten.en} campus`) + (c.diaChiNgan ? `: ${c.diaChiNgan[lang]}` : '');
const moTa = laCiputra
  ? t('Mầm non Casa dei Bambini tại Ciputra (Phú Thượng): khung Cambridge Early Years cho trẻ 3–6 tuổi, nhận bé từ 15 tháng. Dự kiến khai trương quý 4/2027.',
      'Casa dei Bambini at Ciputra (Phú Thượng): Cambridge Early Years framework for ages 3–6, children from 15 months. Expected to open in Q4 2027.')
  : t(`Casa dei Bambini cơ sở ${c.ten.vi}: địa chỉ, bản đồ, lớp học và đăng ký tham quan. Cơ sở đang tuyển sinh. Hotline ${LIEN_HE.hotline}.`,
      `Casa dei Bambini ${c.ten.en} campus: address, map, classes and visit booking. Now enrolling. Hotline ${LIEN_HE.hotlineQuocTe}.`);
const khac = CO_SO.filter((x) => x.slug !== slug && x.trangThai === 'dang-tuyen-sinh');
---
<Base lang={lang} routeKey={key} duongDan={duongDan} tieuDe={tieuDe} tieuDeDayDu={laCiputra} moTa={moTa} schema={[...schema, ...schemaHoiDap]}>

  <section class="dau-trang-con">
    <div class="khung">
      {laCiputra
        ? <span class="huy-hieu huy-hieu--sap">{t('Dự kiến khai trương quý 4/2027', 'Expected to open in Q4 2027')}</span>
        : <span class="huy-hieu">{t('Đang tuyển sinh', 'Enrolling now')}</span>}
      <h1>{laCiputra ? 'Casa dei Bambini Ciputra' : t(`Casa dei Bambini cơ sở ${c.ten.vi}`, `Casa dei Bambini ${c.ten.en} campus`)}</h1>
      {laCiputra
        ? <p class="dau-trang__phu">{t('Chương trình theo khung Cambridge Early Years cho trẻ 3–6 tuổi. Lớp trộn tuổi theo tinh thần Montessori cho bé từ 15 tháng. Dự kiến khai trương quý 4/2027.', 'A programme based on the Cambridge Early Years framework for children aged 3–6. Mixed-age classes in the spirit of Montessori for children from 15 months. Expected to open in Q4 2027.')}</p>
        : <p class="dau-trang__phu">{t('Cơ sở đang tuyển sinh của hệ thống mầm non Casa dei Bambini.', 'A Casa dei Bambini campus that is enrolling now.')}</p>}
    </div>
  </section>

  <section class="phan phan--sat" aria-labelledby="dia-chi">
    <div class="khung luoi luoi--2">
      <div>
        <h2 id="dia-chi">{laCiputra ? t('Cơ sở mới ngay trong khu đô thị Ciputra', 'A new campus inside the Ciputra urban area') : t('Địa chỉ và liên hệ', 'Address and contact')}</h2>
        <p>{c.diaChi ? c.diaChi[lang] : <Can noi={t('địa chỉ đã chốt', 'confirmed address')} />}</p>
        {laCiputra && (
          <>
            <p><Can noi={t('tên tòa nhà, số nhà', 'building name and number')} /></p>
            <p>{t('Phụ huynh đón trả bé tại sảnh tòa nhà (dự kiến).', 'Parents drop off and pick up children at the building lobby (planned).')}</p>
          </>
        )}
        <ul class="danh-sach-tron cum" role="list">
          {c.banDo && <li><a class="nut nut--phu" href={linkBanDo(c.banDo)} rel="noopener"><Icon ten="ban-do" />{t('Mở trên Google Maps', 'Open in Google Maps')}</a></li>}
          <li><a class="nut nut--phu" href={LIEN_HE.tel}><Icon ten="dien-thoai" />{t(`Gọi ${LIEN_HE.hotline}`, `Call ${LIEN_HE.hotlineQuocTe}`)}</a></li>
        </ul>
      </div>
      <AnhCho mo_ta={laCiputra ? t('phối cảnh hoặc mặt tiền tòa nhà Ciputra', 'Ciputra building render or front') : t(`cơ sở vật chất ${c.ten.vi} (không thấy mặt bé)`, `${c.ten.en} campus facilities (no children’s faces)`)} />
    </div>
  </section>

  {laCiputra ? (
    <section class="phan phan--phu phan--sat" aria-labelledby="theo-lua-tuoi">
      <div class="khung">
        <h2 id="theo-lua-tuoi">{t('Chương trình theo từng lứa tuổi', 'Programmes by age')}</h2>
        <div class="bang-cuon" role="region" aria-label={t('Bảng: chương trình theo lứa tuổi', 'Table: programmes by age')} tabindex="0">
          <table>
            <thead><tr><th scope="col">{t('Lứa tuổi', 'Age')}</th><th scope="col">{t('Chương trình', 'Programme')}</th></tr></thead>
            <tbody>
              <tr><th scope="row">{t('Từ 15 tháng đến 3 tuổi', '15 months to 3 years')}</th><td>{t('Lớp trộn tuổi theo tinh thần Montessori: bé tự chọn hoạt động, học cùng anh chị lớn hơn, làm quen tiếng Anh mỗi ngày.', 'Mixed-age classes in the spirit of Montessori: children choose activities, learn alongside older children and are introduced to English every day.')}</td></tr>
              <tr><th scope="row">{t('3–4 tuổi (Early Years 1) và 4–5 tuổi (Early Years 2)', '3–4 years (Early Years 1) and 4–5 years (Early Years 2)')}</th><td>{t('Khung Cambridge Early Years: học qua chơi, lấy trẻ làm trung tâm, phát triển đều sáu lĩnh vực.', 'Cambridge Early Years framework: learning through play, child-centred, developing all six areas.')}</td></tr>
              <tr><th scope="row">{t('5–6 tuổi, lớp tiền tiểu học (Early Years 3)', '5–6 years, pre-primary class (Early Years 3)')}</th><td>{t('Cambridge Early Years 3, bổ sung kỹ năng chuẩn bị vào lớp 1.', 'Cambridge Early Years 3, with added skills to prepare for Grade 1.')}</td></tr>
            </tbody>
          </table>
        </div>
        <p>{t('Hai hệ học để gia đình lựa chọn: hệ quốc tế có giáo viên nước ngoài trong mỗi lớp; hệ song ngữ có hai trợ giảng, giáo viên nước ngoài dạy theo tiết.', 'Two tracks to choose from: the international track has a foreign teacher in every class; the bilingual track has two teaching assistants, with a foreign teacher for scheduled lessons.')}
          {' '}<a href={url('programmes', lang) + '#so-sanh-he'}>{t('So sánh hai hệ', 'Compare the tracks')}</a></p>
        <p><a href={url('nursery', lang)}>{t('Nhà trẻ 15–36 tháng', 'Nursery, 15–36 months')}</a> · <a href={url('kindergarten', lang)}>{t('Mẫu giáo 3–6 tuổi', 'Kindergarten, 3–6 years')}</a></p>
      </div>
    </section>
  ) : (
    <section class="phan phan--phu phan--sat" aria-labelledby="lop-hoc">
      <div class="khung">
        <h2 id="lop-hoc">{t(`Lớp học tại cơ sở ${c.ten.vi}`, `Classes at the ${c.ten.en} campus`)}</h2>
        <BangLop lang={lang} tieuDe={t('Lớp và hệ học ở các cơ sở', 'Classes and tracks across campuses')} />
        <p>
          <a href={url('nursery', lang)}>{t('Nhà trẻ 15–36 tháng', 'Nursery, 15–36 months')}</a> ·
          <a href={url('kindergarten', lang)}>{t('Mẫu giáo 3–6 tuổi', 'Kindergarten, 3–6 years')}</a> ·
          <a href={url('programmes', lang) + '#mot-ngay'}>{t('Giờ học, bữa ăn, mùa hè', 'School hours, meals, summer')}</a>
        </p>
      </div>
    </section>
  )}

  {laCiputra && (
    <section class="phan phan--sat" aria-labelledby="hoi-dap-ciputra">
      <div class="khung noi-dung">
        <h2 id="hoi-dap-ciputra">{t('Câu hỏi về cơ sở Ciputra', 'Questions about the Ciputra campus')}</h2>
        <HoiDap cau={hoiDapCiputra} />
        <p class="sau-luoi">{t('Câu hỏi chung về độ tuổi, giờ học, bữa ăn:', 'General questions about ages, hours and meals:')} <a href={url('admissions', lang) + '#hoi-dap'}>{t('xem trang Tuyển sinh', 'see the Admissions page')}</a>.</p>
      </div>
    </section>
  )}

  <section class="phan phan--sat" aria-labelledby="dang-ky-tieu-de">
    <div class="khung khoi-dang-ky">
      <div>
        {laCiputra ? (
          <>
            <p class="nhan-phan">{t('Đăng ký sớm', 'Register early')}</p>
            <p>{t('Cơ sở đang hoàn thiện và dự kiến khai trương quý 4/2027. Gia đình đăng ký sớm sẽ nhận thông tin chương trình, biểu phí và lịch tham quan ngay khi có.', 'The campus is being completed and is expected to open in Q4 2027. Families who register early will receive programme information, fees and the visit schedule as soon as they are available.')}</p>
            <p>{t('Cần trường ngay cho năm học này?', 'Need a place sooner?')} {khac.map((k, i) => (<>{i > 0 && ', '}<a href={url(`co-so-${k.slug}`, lang)}>{k.ten[lang]}</a></>))} {t('đang tuyển sinh.', 'are enrolling now.')}</p>
          </>
        ) : (
          <>
            <p class="nhan-phan">{t('Tham quan', 'Visit')}</p>
            <p>{t(`Để lại số điện thoại, nhà trường gọi lại để hẹn lịch tham quan cơ sở ${c.ten.vi} và gửi biểu phí.`, `Leave your phone number and the school will call you to arrange a visit to the ${c.ten.en} campus and send the fee schedule.`)}</p>
          </>
        )}
        <p>{t('Hoặc gọi', 'Or call')} <a href={LIEN_HE.tel}>{lang === 'en' ? LIEN_HE.hotlineQuocTe : LIEN_HE.hotline}</a> · <a href={`mailto:${LIEN_HE.email}`}>{LIEN_HE.email}</a></p>
      </div>
      <FormDangKy lang={lang} coSoChon={slug}
        tieuDe={laCiputra ? t('Đăng ký nhận thông tin sớm', 'Get early updates') : t(`Đăng ký tham quan cơ sở ${c.ten.vi}`, `Book a visit to ${c.ten.en}`)}
        nhanNut={laCiputra ? t('Đăng ký nhận thông tin', 'Get updates') : undefined} />
    </div>
  </section>
</Base>
