---
// Tuyển sinh: quy trình, biểu phí, câu hỏi chung, form (#dang-ky).
import Base from '../../layouts/Base.astro';
import FormDangKy from '../FormDangKy.astro';
import HoiDap from '../HoiDap.astro';
import { CIPUTRA_CONG_KHAI, type Lang } from '../../data/co-so';
import { LIEN_HE } from '../../data/lien-he';
import { url, taoT } from '../../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = taoT(lang);
const duongDan = [
  { ten: t('Trang chủ', 'Home'), href: url('home', lang) },
  { ten: t('Tuyển sinh', 'Admissions'), href: url('admissions', lang) },
];
const hotline = lang === 'en' ? LIEN_HE.hotlineQuocTe : LIEN_HE.hotline;
const hoiDap = [
  { hoi: t('Bé bao nhiêu tháng thì được nhận?', 'From what age do you accept children?'),
    dap: t('Từ 15 tháng đến 6 tuổi, theo chương trình và điều kiện tuyển sinh của từng cơ sở.', 'From 15 months to 6 years, according to the programme and admission conditions at each campus.') },
  { hoi: t('Hệ quốc tế và hệ song ngữ khác nhau ở đâu?', 'How do the international and bilingual tracks differ?'),
    dap: t('Hệ quốc tế có giáo viên nước ngoài trong mỗi lớp 3–6 tuổi, cùng giáo viên chủ nhiệm và trợ giảng. Hệ song ngữ có giáo viên chủ nhiệm và hai trợ giảng; giáo viên nước ngoài dạy theo tiết.', 'The international track has a foreign teacher in every class for ages 3–6, together with a homeroom teacher and a teaching assistant. The bilingual track has a homeroom teacher and two teaching assistants; a foreign teacher teaches scheduled lessons.') },
  { hoi: t('Giờ học và giờ đón muộn thế nào?', 'What are the school hours and late pick-up?'),
    dap: t('Bé học từ 7h30 đến 17h30, thứ Hai đến thứ Sáu. Có dịch vụ trông muộn đến 18h30, có tính phí.', 'Children attend from 7:30 to 17:30, Monday to Friday. Late care is available until 18:30 for a fee.') },
  { hoi: t('Bé ăn uống thế nào?', 'What do children eat?'),
    dap: t('Bé được phục vụ 4 bữa mỗi ngày theo thực đơn phù hợp lứa tuổi mầm non. Bếp một chiều của trường tự nấu toàn bộ, kể cả bánh và đồ ăn nhẹ.', 'Children are served 4 meals a day from a menu suited to preschool ages. Everything is cooked in the school’s own one-way kitchen, including cakes and snacks.') },
  { hoi: t('Mùa hè trường có học không?', 'Is the school open in summer?'),
    dap: t('Có. Nhà trường tổ chức hoạt động học tập trong hè và nghỉ 1 tuần theo lịch năm học được thông báo.', 'Yes. The school runs learning activities in summer and closes for one week according to the announced school calendar.') },
  { hoi: t('Trường có ngoại khoá, trại hè không?', 'Are there extracurricular activities or a summer camp?'),
    dap: t('Có. Nhà trường tổ chức hoạt động ngoại khoá, dã ngoại và chương trình hè phù hợp với từng độ tuổi, theo đăng ký và thu phí riêng.', 'Yes. The school runs extracurricular activities, outings and summer programmes for each age group, on registration and with separate fees.') },
  { hoi: t('Đăng ký xong thì bao lâu nhà trường gọi lại?', 'How soon will the school call me back?'),
    dap: t('Trong ngày làm việc với đăng ký gửi trong giờ hành chính. Đăng ký gửi ngoài giờ, cuối tuần hoặc ngày nghỉ được phản hồi vào ngày làm việc tiếp theo.', 'Within the same working day for requests sent during office hours. Requests sent outside office hours, at weekends or on holidays are answered on the next working day.') },
  { hoi: t('Học phí bao nhiêu?', 'How much are the fees?'),
    dap: t(`Nhà trường gửi biểu phí sau khi trao đổi với gia đình. Anh/chị để lại số điện thoại hoặc gọi ${LIEN_HE.hotline}.`, `The school sends the fee schedule after talking with your family. Please leave your phone number or call ${LIEN_HE.hotlineQuocTe}.`) },
];
const schema = [{
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: hoiDap.map((q) => ({ '@type': 'Question', name: q.hoi, acceptedAnswer: { '@type': 'Answer', text: q.dap } })),
}];
---
<Base lang={lang} routeKey="admissions" duongDan={duongDan} schema={schema}
  tieuDe={t('Tuyển sinh và đăng ký tham quan', 'Admissions and visit booking')}
  moTa={t(
    'Đăng ký tham quan Casa Preschool: độ tuổi nhận, quy trình, câu hỏi thường gặp và cách nhận biểu phí. Hotline 0989 059 838.',
    'Book a visit to Casa Preschool: age of entry, how admissions work, common questions and how to get the fee schedule. Hotline +84 989 059 838.',
  )}>

  <section class="dau-trang-con">
    <div class="khung">
      <h1>{t('Tuyển sinh và đăng ký tham quan', 'Admissions and visit booking')}</h1>
      <p class="dau-trang__phu">{t('Nhận bé từ 15 tháng đến 6 tuổi. Hãy đến xem trường cùng con trước khi quyết định.', 'We welcome children from 15 months to 6 years. Come and see the school with your child before you decide.')}</p>
    </div>
  </section>

  <section class="phan phan--sat" aria-labelledby="quy-trinh">
    <div class="khung noi-dung">
      <h2 id="quy-trinh">{t('Các bước', 'How it works')}</h2>
      <ol class="cac-buoc">
        <li><strong>{t('Gửi thông tin', 'Send your details')}.</strong> {t('Gửi đăng ký bên dưới hoặc gọi', 'Send the form below or call')} <a href={LIEN_HE.tel}>{hotline}</a>. {t('Bộ phận tuyển sinh liên hệ để tìm hiểu nhu cầu của gia đình, độ tuổi của bé, chương trình và cơ sở mong muốn: trong ngày làm việc với đăng ký gửi trong giờ hành chính; đăng ký ngoài giờ, cuối tuần hoặc ngày nghỉ được phản hồi vào ngày làm việc tiếp theo.', 'Our admissions team contacts you to learn about your family’s needs, your child’s age and the programme and campus you prefer: within the same working day for requests sent during office hours, or on the next working day for requests sent outside office hours, at weekends or on holidays.')}</li>
        <li><strong>{t('Tư vấn và đặt lịch tham quan', 'Advice and visit booking')}.</strong> {t('Nhà trường giới thiệu chương trình, các hệ học, học phí và chính sách tuyển sinh hiện hành, rồi sắp xếp lịch tham quan thuận tiện cho gia đình.', 'We introduce the programme, the tracks, the fees and current admission policies, then arrange a visit at a time that suits your family.')}</li>
        <li><strong>{t('Tham quan và trải nghiệm tại trường', 'Visit and experience the school')}.</strong> {t('Ba mẹ cùng bé đến xem cơ sở vật chất, môi trường học tập và trao đổi trực tiếp với đại diện nhà trường. Buổi tham quan dự kiến 30–45 phút, có thể điều chỉnh theo nhu cầu của gia đình.', 'You and your child see the facilities and learning environment and talk directly with a school representative. A visit is expected to take 30–45 minutes and can be adjusted to your needs.')}</li>
        <li><strong>{t('Học thử và đăng ký nhập học', 'Trial and enrolment')}.</strong> {t('Nếu gia đình có nhu cầu, nhà trường tư vấn chương trình học thử phù hợp với độ tuổi của bé. Khi gia đình quyết định nhập học, bộ phận tuyển sinh hướng dẫn hoàn thiện hồ sơ, hợp đồng và các thủ tục cần thiết.', 'If you wish, we advise on a trial suited to your child’s age. Once you decide to enrol, our admissions team guides you through the forms, contract and other steps.')}</li>
        <li><strong>{t('Đồng hành trong thời gian đầu', 'Support in the first weeks')}.</strong> {t('Giáo viên phối hợp với ba mẹ giúp bé làm quen với môi trường mới và cập nhật tình hình thích nghi của con.', 'Teachers work with you to help your child settle into the new environment and keep you updated on how they are adapting.')}</li>
      </ol>

      <h2 id="bieu-phi">{t('Biểu phí', 'Fees')}</h2>
      <p>{t('Liên hệ để nhận biểu phí. Nhà trường gửi biểu phí sau khi trao đổi với gia đình về độ tuổi của bé, cơ sở và hệ học.', "Contact us for the fee schedule. The school sends it after talking with your family about your child's age, campus and track.")}</p>
      <p><a href="#dang-ky">{t('Để lại số điện thoại để nhận biểu phí', 'Leave your number to get the fee schedule')}</a></p>
    </div>
  </section>

  <section class="phan phan--phu phan--sat" aria-labelledby="hoi-dap-tieu-de">
    <div class="khung noi-dung">
      <h2 id="hoi-dap-tieu-de">{t('Câu hỏi thường gặp', 'Frequently asked questions')}</h2>
      <HoiDap cau={hoiDap} id="hoi-dap" />
      {CIPUTRA_CONG_KHAI && <p class="sau-luoi">{t('Câu hỏi riêng về cơ sở mới:', 'Questions about the new campus:')} <a href={url('co-so-ciputra', lang)}>{t('xem trang Ciputra', 'see the Ciputra page')}</a>.</p>}
    </div>
  </section>

  <section class="phan phan--sat" aria-labelledby="dang-ky-tieu-de">
    <div class="khung khoi-dang-ky">
      <div>
        <p class="nhan-phan">{t('Tham quan', 'Visit')}</p>
        <p>{t('Để lại số điện thoại, nhà trường gọi lại để hẹn lịch tham quan và gửi biểu phí.', 'Leave your phone number and the school will call you to arrange a visit and send the fee schedule.')}</p>
        <p>{t('Chưa biết chọn cơ sở nào?', 'Not sure which campus?')} <a href={url('campuses', lang)}>{t('Xem các cơ sở', 'See all campuses')}</a>. {t('Hoặc liên hệ qua', 'Or reach us via')} <a href={url('contact', lang)}>{t('trang Liên hệ', 'the Contact page')}</a>.</p>
      </div>
      <FormDangKy lang={lang} />
    </div>
  </section>
</Base>
