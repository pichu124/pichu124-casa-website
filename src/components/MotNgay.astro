---
// "Một ngày ở Casa": một nguồn dùng chung cho trang chủ và trang Chương trình.
// Phiếu câu 12 (18/11/2026): trông muộn có tính phí; 4 bữa theo thực đơn của nhà trường
// (chưa công bố "bếp trường tự nấu" cho tới khi xác nhận mô hình bếp từng cơ sở).
import type { Lang } from '../data/co-so';
import { taoT } from '../i18n/routes';
interface Props { lang: Lang }
const t = taoT(Astro.props.lang);
---
<ul class="o-so-lieu">
  <li><strong>7h30–17h30</strong>{t('Thứ Hai đến thứ Sáu', 'Monday to Friday')}</li>
  <li><strong>{t('Trông muộn đến 18h30', 'Late care until 18:30')}</strong>{t('Có tính phí, khi ba mẹ cần đón muộn', 'For a fee, when parents need to pick up later')}</li>
  <li><strong>{t('4 bữa mỗi ngày', '4 meals a day')}</strong>{t('Theo thực đơn của nhà trường', "Following the school's menu")}</li>
  <li><strong>{t('Hè vẫn học', 'Open in summer')}</strong>{t('Nghỉ 1 tuần theo lịch năm học', 'Closed for one week, per the school calendar')}</li>
</ul>
