# Cấu hình dịch vụ nhận form đăng ký tham quan (Giai đoạn 4).
# Trên VPS, tệp này nằm ở /etc/casa-website/form.env (root:casa-form, quyền 640).
# KHÔNG đưa tệp đã điền mật khẩu lên GitHub, không gửi vào chat.

# Tài khoản Google Workspace dùng để gửi thư (phiếu câu 21)
SMTP_TAI_KHOAN=tuyensinh@cdb.edu.vn
# Mật khẩu ứng dụng 16 ký tự tạo ở myaccount.google.com/apppasswords (viết liền, không dấu cách).
# Không dùng mật khẩu đăng nhập Gmail thường.
SMTP_MAT_KHAU=DIEN_MAT_KHAU_UNG_DUNG

# Hộp thư nhận thông báo đăng ký mới (nhiều địa chỉ: cách nhau bằng dấu phẩy)
THU_GUI_TOI=tuyensinh@cdb.edu.vn
TEN_NGUOI_GUI=Website Casa Preschool

# Máy chủ gửi thư của Google (để nguyên)
SMTP_MAY_CHU=smtp.gmail.com
SMTP_CONG=465

# Dịch vụ chỉ nghe trong máy (Caddy chuyển /api/* tới đây)
DIA_CHI=127.0.0.1
CONG=3100
THU_MUC_DU_LIEU=/var/lib/casa-website

# Mỗi địa chỉ IP gửi tối đa bấy nhiêu lần trong 1 giờ
GIOI_HAN_MOI_GIO=5

# Thời hạn lưu đăng ký, tính bằng ngày (365 = 12 tháng, chờ Ban lãnh đạo duyệt)
LUU_TOI_DA_NGAY=365
