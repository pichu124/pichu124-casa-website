# Khối Caddy của website Casa dei Bambini — BẢN THỬ (Giai đoạn 5).
# Đặt tại /etc/caddy/sites/casa-website.caddy; Caddyfile chính chỉ thêm một dòng:
#   import /etc/caddy/sites/*.caddy
# Không sửa khối của app casa-mamnon.
#
# Tên miền bản thử: casa-website-thu.duckdns.org (DuckDNS, chọn ngày 15/11/2026).
# Thay một chỗ trước khi dùng:
#   MA_BAM_MAT_KHAU   → kết quả của lệnh `caddy hash-password` (không phải mật khẩu gốc)
# Khi tệp mẫu này thay đổi, áp dụng lên máy bằng: sudo bash /opt/casa-website/src/deploy/cap-nhat-caddy.sh
# (kịch bản giữ nguyên tên miền và mật khẩu đang dùng trên máy)

casa-website-thu.duckdns.org {
	root * /var/www/casa-website/current
	encode zstd gzip

	# Bản thử: chỉ người có mật khẩu mới xem được
	basic_auth {
		xem MA_BAM_MAT_KHAU
	}

	header {
		# Không cho Google lập chỉ mục bản thử
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Tệp trong /_astro/ có mã băm trong tên: lưu cache lâu dài
	@tep_bam path /_astro/*
	header @tep_bam Cache-Control "public, max-age=31536000, immutable"

	# Trang HTML: luôn kiểm tra bản mới
	@html path *.html */
	header @html Cache-Control "no-cache"

	# Dịch vụ nhận form đăng ký tham quan (Giai đoạn 4), chỉ nghe trong máy
	reverse_proxy /api/* 127.0.0.1:3100

	file_server

	# Dịch vụ form không trả lời: báo phụ huynh gọi hotline thay vì trang trắng
	handle_errors 502 503 504 {
		header Content-Type "text/plain; charset=utf-8"
		respond "Hệ thống nhận đăng ký đang tạm dừng. Xin gọi 0989 059 838 để nhà trường hẹn lịch tham quan. / Our booking system is temporarily unavailable. Please call +84 989 059 838." 503
	}

	handle_errors 404 {
		@en path /en/*
		rewrite @en /en/404/index.html
		rewrite * /404.html
		file_server
	}

	# Nhật ký: Caddy ghi vào journal (xem bằng: sudo journalctl -u caddy)
}
